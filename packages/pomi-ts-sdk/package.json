{
  "name": "@ominira/pomi-sdk",
  "version": "0.3.0",
  "description": "Planejador da Ominira SDK",
  "homepage": "https://github.com/ominira-unicamp/pomi-ts-sdk#readme",
  "bugs": {
    "url": "https://github.com/ominira-unicamp/pomi-ts-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ominira-unicamp/pomi-ts-sdk.git"
  },
  "license": "MIT",
  "author": "goliasvictor",
  "private": false,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./errors": "./src/errors.ts",
    "./api": "./src/api.ts",
    "./generated": "./src/generated/index.ts",
    "./generated-client": "./src/generatedClient.ts",
    "./generated-pagination": "./src/generatedPagination.ts",
    "./course-catalog": "./src/courseCatalog.ts",
    "./curriculum-persistence": "./src/curriculumPersistence.ts",
    "./curriculum-planner": "./src/curriculumPlanner.ts",
    "./curriculum-prerequisites": "./src/curriculumPrerequisites.ts",
    "./curriculum-suggestions": "./src/curriculumSuggestions.ts",
    "./daily-menu": "./src/dailyMenu.ts",
    "./exchange": "./src/exchange.ts",
    "./feedback": "./src/feedback.ts",
    "./shared-period-planning": "./src/sharedPeriodPlanning.ts",
    "./student-absences": "./src/studentAbsences.ts",
    "./student-interests": "./src/studentInterests.ts",
    "./student": "./src/student.ts",
    "./semester-planning": "./src/semesterPlanning.ts",
    "./student-social": "./src/studentSocial.ts",
    "./tag-taxonomy": "./src/tagTaxonomy.ts"
  },
  "scripts": {
    "generate": "tsx sdk-gen/generate.ts",
    "architecture:check": "node scripts/check-architecture.mjs",
    "check": "npm run generate && npm run architecture:check && tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test src/generated*.test.ts",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "ts-morph": "^27.0.2",
    "tsx": "^4.23.13"
  },
  "keywords": [
    "pomi",
    "ominira",
    "sdk",
    "unicamp",
    "typescript"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
