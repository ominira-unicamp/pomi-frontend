{
  "name": "@ominira/pomi-sdk",
  "version": "0.3.0",
  "description": "Planejador da Ominira SDK",
  "homepage": "https://github.com/ominira-unicamp/pomi-ts-sdk#readme",
  "bugs": {
    "url": "https://github.com/ominira-unicamp/pomi-ts-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ominira-unicamp/pomi-ts-sdk.git"
  },
  "license": "MIT",
  "author": "goliasvictor",
  "private": false,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./errors": "./src/errors.ts",
    "./generated": "./src/generated/index.ts",
    "./generated/app": "./src/generated/app/index.ts",
    "./generated/data": "./src/generated/data/index.ts",
    "./generated-client": "./src/generatedClient.ts",
    "./generated-pagination": "./src/generatedPagination.ts"
  },
  "scripts": {
    "generate": "node --import tsx sdk-gen/generate.ts",
    "generate:check": "node --import tsx sdk-gen/generate.ts --check",
    "generate:typecheck": "tsc --noEmit -p tsconfig.generated.json",
    "test:generator": "node --import tsx --test sdk-gen/*.test.ts",
    "architecture:check": "node scripts/check-architecture.mjs",
    "check": "npm run generate:check && npm run architecture:check && tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test src/generated*.test.ts",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "ts-morph": "^27.0.2",
    "tsx": "^4.23.13"
  },
  "keywords": [
    "pomi",
    "ominira",
    "sdk",
    "unicamp",
    "typescript"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
